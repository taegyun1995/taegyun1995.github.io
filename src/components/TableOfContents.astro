---
import { ListTree } from '@lucide/astro';
import type { MarkdownHeading } from 'astro';

interface Props {
  headings: MarkdownHeading[];
}

const { headings } = Astro.props;
const items = headings.filter((heading) => heading.depth === 2 || heading.depth === 3);
---

{items.length > 0 && (
  <aside class="toc" aria-label="목차">
    <div class="toc-title"><ListTree size={17} />목차</div>
    <nav>
      {items.map((heading) => (
        <a class:list={{ nested: heading.depth === 3 }} href={`#${heading.slug}`}>
          {heading.text}
        </a>
      ))}
    </nav>
  </aside>
)}
