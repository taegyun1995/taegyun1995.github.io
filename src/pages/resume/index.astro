---
import {
  ArrowDown,
  ArrowUp,
  ArrowUpRight,
  FileText,
  GripVertical,
  ListChecks,
  Printer,
  Square,
  X,
} from '@lucide/astro';

import { RESUME } from '@/data/resume';
import BaseLayout from '@/layouts/BaseLayout.astro';

const resumeNavigation = [
  { href: '#resume-experience', label: '경력' },
  { href: '#resume-personal-project', label: '개인 프로젝트' },
  { href: '#resume-skills', label: '기술 스택' },
];

const coreProjectTitles = new Set([
  'PortOne 국내외 결제 통합 및 정합성 강화',
  'ODS 외부 시스템 연동 (PG·GoodsFlow·MES)',
  'ODS 공정 모델 V2 전환과 도메인 모듈화',
  '해양 대기질 데이터 조회 성능 개선',
]);

const experienceGroups = RESUME.experiences.map((experience, experienceIndex) => ({
  ...experience,
  printKey: `experience-${experienceIndex}`,
  projects: RESUME.projects
    .filter((project) => project.company === experience.company)
    .map((project, projectIndex) => ({
      ...project,
      printKey: `experience-${experienceIndex}-project-${projectIndex}`,
      isCore: coreProjectTitles.has(project.title),
    })),
  contributions: experience.additionalContributions.map((contribution, contributionIndex) => ({
    ...contribution,
    printKey: `experience-${experienceIndex}-contribution-${contributionIndex}`,
  })),
}));

const personalProjectGroups = RESUME.personalProjects.map((project, projectIndex) => ({
  ...project,
  printKey: `personal-project-${projectIndex}`,
}));

const printItems = [
  ...experienceGroups.flatMap((experience) => [
    ...experience.projects.map((project) => ({
      key: project.printKey,
      kind: '프로젝트',
      title: project.title,
      description: `${project.situation} ${project.task}`,
      context: `${experience.company} · ${project.period}`,
    })),
    ...experience.contributions.map((contribution) => ({
      key: contribution.printKey,
      kind: '추가 기여',
      title: contribution.title,
      description: contribution.description,
      context: `${experience.company} · ${experience.period}`,
    })),
  ]),
  ...personalProjectGroups.map((project) => ({
    key: project.printKey,
    kind: '개인 프로젝트',
    title: project.title,
    description: `${project.situation} ${project.task}`,
    context: project.period,
  })),
  {
    key: 'resume-skills',
    kind: '기술',
    title: '기술 스택 전체',
    description: 'Backend · Database · Test / Library · Infra / Delivery',
    context: '공통',
  },
];

const corePrintKeys = [
  ...experienceGroups.flatMap((experience) =>
    experience.projects.filter((project) => project.isCore).map((project) => project.printKey),
  ),
  'resume-skills',
];
---

<BaseLayout
  title={`${RESUME.name} 이력서`}
  description={`Java와 Spring을 사용하는 ${RESUME.experienceLabel} 백엔드 개발자 ${RESUME.name}의 경력과 기술 경험입니다.`}
>
  <header class="resume-page-header page-container">
    <div class="resume-page-main">
      <div class="resume-page-intro">
        <p class="section-kicker">Resume <span>·</span> Backend Engineer</p>
        <h1>{RESUME.name}</h1>
        <p class="resume-page-role">{RESUME.title} <span>·</span> {RESUME.experienceLabel}</p>
        <p class="resume-page-summary">{RESUME.resumeSummary}</p>
        <ul class="resume-contact-list" aria-label="연락처">
          {RESUME.contacts.map((contact) => (
            <li>
              <span>{contact.label}</span>
              <a
                href={contact.href}
                target={contact.href.startsWith('http') ? '_blank' : undefined}
                rel={contact.href.startsWith('http') ? 'noreferrer' : undefined}
              >
                {contact.value}
              </a>
            </li>
          ))}
        </ul>
        <div class="resume-actions">
          <button class="secondary-link configure-resume-print" type="button">
            <Printer size={17} />PDF 구성
          </button>
        </div>
      </div>

      <aside class="resume-impact-card" aria-label="대표 성과: 조회 시간을 460초에서 3.4초로 단축">
        <div class="resume-impact-topline">
          <span>SELECTED IMPACT</span>
          <span>2024.04–05</span>
        </div>
        <p class="resume-impact-label">월 단위 해양 대기질 데이터 조회</p>
        <div class="resume-impact-metric">
          <strong>460<small>초</small></strong>
          <span aria-hidden="true">→</span>
          <strong>3.4<small>초</small></strong>
        </div>
        <div class="resume-impact-track" aria-hidden="true"><span></span></div>
        <p class="resume-impact-result">조회 시간 <strong>99.25% 단축</strong></p>
        <a href="/portfolio/#query-performance">
          개선 과정 보기 <ArrowUpRight size={15} />
        </a>
      </aside>
    </div>

    <div class="resume-page-focusline" aria-label="주요 전문 분야">
      <span>FOCUS</span>
      <ul>
        <li>결제 데이터 정합성</li>
        <li>외부 시스템 연동</li>
        <li>조회 성능 개선</li>
      </ul>
    </div>
  </header>

  <section class="resume-strengths page-container" aria-labelledby="resume-strengths-title">
    <div class="resume-strengths-heading">
      <p>How I work</p>
      <h2 id="resume-strengths-title">운영의 문제를 구조와 수치로 풀어냅니다.</h2>
    </div>
    <div class="resume-strength-list">
      {RESUME.strengths.map((strength, index) => (
        <article>
          <span class="resume-strength-index">0{index + 1}</span>
          <div>
            <h3>{strength.title}</h3>
            <p>{strength.description}</p>
            <small>{strength.detail}</small>
          </div>
        </article>
      ))}
    </div>
  </section>

  <div class="resume-document page-container">
    <aside class="resume-sidebar" aria-label="이력서 목차">
      <p>Contents</p>
      <nav>
        {resumeNavigation.map((item, index) => (
          <a class:list={{ active: index === 0 }} href={item.href}>{item.label}</a>
        ))}
      </nav>
    </aside>

    <div class="resume-content">
      <section
        id="resume-experience"
        class="resume-section"
        data-resume-section
        aria-labelledby="resume-experience-title"
      >
        <div class="resume-section-title">
          <p>Experience</p>
          <h2 id="resume-experience-title">경력</h2>
        </div>

        <div class="resume-entry-list">
          {experienceGroups.map((experience) => (
              <article class="resume-entry" data-print-company={experience.printKey}>
                <div class="resume-entry-meta">
                  <time>{experience.period}</time>
                  <span>{experience.role}</span>
                </div>
                <div class="resume-entry-content">
                  <h3>{experience.company}</h3>
                  <p class="resume-organization">{experience.organization}</p>
                  <p>{experience.description}</p>

                  <div class="resume-company-project-list">
                    {experience.projects.map((project) => (
                      <article class="resume-company-project" data-print-key={project.printKey}>
                        <div class="resume-company-project-heading">
                          <div>
                            <time>{project.period}</time>
                            <a class="resume-project-link" href={project.href}>
                              <h4>{project.title}<ArrowUpRight size={15} /></h4>
                            </a>
                          </div>
                          <div class="resume-keywords" aria-label="사용 기술">
                            {project.keywords.map((keyword) => <span>{keyword}</span>)}
                          </div>
                        </div>
                        <div class="resume-star-story" aria-label="STAR 프로젝트 설명">
                          <div class="resume-star-row">
                            <div class="resume-star-marker"><strong>S</strong><span>상황</span></div>
                            <p>{project.situation}</p>
                          </div>
                          <div class="resume-star-row">
                            <div class="resume-star-marker"><strong>T</strong><span>목표·역할</span></div>
                            <p>{project.task}</p>
                          </div>
                          <div class="resume-star-row">
                            <div class="resume-star-marker"><strong>A</strong><span>실행·판단</span></div>
                            <ul class="resume-star-actions">
                              {project.highlights.map((highlight) => <li>{highlight}</li>)}
                            </ul>
                          </div>
                          <div class="resume-star-row">
                            <div class="resume-star-marker"><strong>R</strong><span>결과</span></div>
                            <p class="resume-star-result">{project.result}</p>
                          </div>
                        </div>
                      </article>
                    ))}
                  </div>

                  <div class="resume-additional-contributions">
                    <strong>추가 기여</strong>
                    <ul>
                      {experience.contributions.map((contribution) => (
                        <li data-print-key={contribution.printKey}>
                          <strong>{contribution.title}</strong>
                          <span>{contribution.description}</span>
                        </li>
                      ))}
                    </ul>
                  </div>
                </div>
              </article>
          ))}
        </div>
      </section>

      <section
        id="resume-personal-project"
        class="resume-section"
        data-resume-section
        aria-labelledby="resume-personal-project-title"
      >
        <div class="resume-section-title">
          <p>Personal Project</p>
          <h2 id="resume-personal-project-title">개인 프로젝트</h2>
        </div>

        <div class="resume-entry-list">
          {personalProjectGroups.map((project) => (
            <article
              class="resume-entry resume-personal-project-entry"
              data-print-key={project.printKey}
            >
              <div class="resume-entry-meta">
                <time>{project.period}</time>
                <span>{project.role}</span>
              </div>
              <div class="resume-entry-content">
                <p class="resume-organization">{project.context}</p>
                <a class="resume-project-link" href={project.href}>
                  <h3>{project.title}<ArrowUpRight size={16} /></h3>
                </a>
                <div class="resume-star-story" aria-label="STAR 프로젝트 설명">
                  <div class="resume-star-row">
                    <div class="resume-star-marker"><strong>S</strong><span>상황</span></div>
                    <p>{project.situation}</p>
                  </div>
                  <div class="resume-star-row">
                    <div class="resume-star-marker"><strong>T</strong><span>목표·역할</span></div>
                    <p>{project.task}</p>
                  </div>
                  <div class="resume-star-row">
                    <div class="resume-star-marker"><strong>A</strong><span>실행·판단</span></div>
                    <ul class="resume-star-actions">
                      {project.highlights.map((highlight) => <li>{highlight}</li>)}
                    </ul>
                  </div>
                  <div class="resume-star-row">
                    <div class="resume-star-marker"><strong>R</strong><span>결과</span></div>
                    <p class="resume-star-result">{project.result}</p>
                  </div>
                </div>
                <div class="resume-keywords resume-personal-keywords" aria-label="사용 기술">
                  {project.keywords.map((keyword) => <span>{keyword}</span>)}
                </div>
              </div>
            </article>
          ))}
        </div>
      </section>

      <section
        id="resume-skills"
        class="resume-section"
        data-resume-section
        data-print-key="resume-skills"
        aria-labelledby="resume-skill-title"
      >
        <div class="resume-section-title">
          <p>Skills</p>
          <h2 id="resume-skill-title">기술 스택</h2>
        </div>

        <dl class="resume-skill-list">
          {RESUME.skills.map((skill) => (
            <div>
              <dt>{skill.label}</dt>
              <dd>{skill.items.join(' · ')}</dd>
            </div>
          ))}
        </dl>
      </section>
    </div>
  </div>

  <section class="resume-print-document page-container" aria-hidden="true">
    <h2 class="resume-print-heading">선택 경험</h2>
    <div class="resume-print-freeform-list" data-resume-print-document></div>
  </section>

  <dialog
    class="resume-print-dialog"
    aria-labelledby="resume-print-dialog-title"
    data-core-keys={JSON.stringify(corePrintKeys)}
  >
    <form method="dialog" class="resume-print-form">
      <header class="resume-print-dialog-header">
        <div>
          <p class="section-kicker">PDF Builder</p>
          <h2 id="resume-print-dialog-title">PDF 구성</h2>
          <p>항목을 선택한 뒤 드래그해서 PDF에 표시할 순서를 정하세요.</p>
        </div>
        <button class="icon-button" type="submit" value="cancel" aria-label="닫기" title="닫기">
          <X size={19} />
        </button>
      </header>

      <div class="resume-print-toolbar">
        <div role="group" aria-label="PDF 구성 프리셋">
          <button class="secondary-link" type="button" data-print-preset="core">
            <FileText size={16} />핵심 구성
          </button>
          <button class="secondary-link" type="button" data-print-preset="all">
            <ListChecks size={16} />전체 선택
          </button>
          <button class="secondary-link" type="button" data-print-preset="none">
            <Square size={16} />선택 해제
          </button>
        </div>
        <output class="resume-print-count" aria-live="polite">0개 선택</output>
      </div>

      <div class="resume-print-options" data-print-options>
        <ol class="resume-print-option-list" aria-label="PDF 출력 순서">
          {printItems.map((item) => (
            <li
              class="resume-print-option"
              data-print-key={item.key}
              data-print-kind={item.kind}
              data-print-context={item.context}
              draggable="true"
            >
              <span class="resume-print-drag-handle" aria-hidden="true">
                <GripVertical size={18} />
              </span>
              <label>
                <input type="checkbox" name="resume-print-item" value={item.key} checked />
                <span>
                  <small>{item.kind} · {item.context}</small>
                  <strong>{item.title}</strong>
                  <span class="resume-print-option-description">{item.description}</span>
                </span>
              </label>
              <span class="resume-print-order-controls" aria-label={`${item.title} 순서 변경`}>
                <button
                  class="icon-button"
                  type="button"
                  data-print-move="up"
                  aria-label={`${item.title} 위로 이동`}
                  title="위로 이동"
                >
                  <ArrowUp size={15} />
                </button>
                <button
                  class="icon-button"
                  type="button"
                  data-print-move="down"
                  aria-label={`${item.title} 아래로 이동`}
                  title="아래로 이동"
                >
                  <ArrowDown size={15} />
                </button>
              </span>
            </li>
          ))}
        </ol>
      </div>

      <footer class="resume-print-dialog-footer">
        <button class="secondary-link" type="submit" value="cancel">취소</button>
        <button class="primary-link resume-print-confirm" type="button">
          <Printer size={17} />PDF로 인쇄
        </button>
      </footer>
    </form>
  </dialog>
</BaseLayout>

<script>
  const PRINT_BUILDER_STORAGE_KEY = 'resume-print-builder-v3';
  const LEGACY_PRINT_SELECTION_STORAGE_KEY = 'resume-print-selection-v2';
  const printDialog = document.querySelector<HTMLDialogElement>('.resume-print-dialog');
  const configurePrintButton = document.querySelector<HTMLButtonElement>(
    '.configure-resume-print',
  );
  const printConfirmButton = document.querySelector<HTMLButtonElement>('.resume-print-confirm');
  const printCount = document.querySelector<HTMLOutputElement>('.resume-print-count');
  const printOptionList = document.querySelector<HTMLOListElement>('.resume-print-option-list');
  const printDocument = document.querySelector<HTMLElement>('[data-resume-print-document]');
  const printCheckboxes = Array.from(
    document.querySelectorAll<HTMLInputElement>('input[name="resume-print-item"]'),
  );
  const printOptionRows = Array.from(
    document.querySelectorAll<HTMLLIElement>('.resume-print-option'),
  );
  const printPresetButtons = Array.from(
    document.querySelectorAll<HTMLButtonElement>('[data-print-preset]'),
  );
  let printSelectionBeforeDialog: string[] = [];
  let printOrderBeforeDialog: string[] = [];
  let draggedPrintOption: HTMLLIElement | null = null;

  const getSelectedPrintKeys = () =>
    printCheckboxes.filter((checkbox) => checkbox.checked).map((checkbox) => checkbox.value);

  const getPrintOrder = () =>
    Array.from(printOptionList?.querySelectorAll<HTMLLIElement>('.resume-print-option') ?? []).map(
      (option) => option.dataset.printKey ?? '',
    );

  const normalizePrintOrder = (order: string[]) => {
    const availableKeys = printOptionRows.map((option) => option.dataset.printKey ?? '');
    const availableKeySet = new Set(availableKeys);
    const uniqueSavedKeys = order.filter(
      (key, index) => availableKeySet.has(key) && order.indexOf(key) === index,
    );

    return [...uniqueSavedKeys, ...availableKeys.filter((key) => !uniqueSavedKeys.includes(key))];
  };

  const setPrintOrder = (order: string[]) => {
    if (!printOptionList) return;

    const optionByKey = new Map(
      printOptionRows.map((option) => [option.dataset.printKey ?? '', option]),
    );
    normalizePrintOrder(order).forEach((key) => {
      const option = optionByKey.get(key);
      if (option) printOptionList.append(option);
    });
  };

  const persistPrintBuilder = () => {
    localStorage.setItem(
      PRINT_BUILDER_STORAGE_KEY,
      JSON.stringify({ selectedKeys: getSelectedPrintKeys(), order: getPrintOrder() }),
    );
  };

  const updatePrintSelectionState = (persist = true) => {
    const selectedKeys = getSelectedPrintKeys();
    if (printCount) printCount.value = `${selectedKeys.length}개 선택`;
    if (printConfirmButton) printConfirmButton.disabled = selectedKeys.length === 0;

    const selectedKeySet = new Set(selectedKeys);
    printOptionRows.forEach((option) => {
      const isSelected = selectedKeySet.has(option.dataset.printKey ?? '');
      option.dataset.printSelected = isSelected ? 'true' : 'false';
      option.draggable = isSelected;
      option.querySelectorAll<HTMLButtonElement>('[data-print-move]').forEach((button) => {
        button.disabled = !isSelected;
      });
    });

    if (persist) persistPrintBuilder();
  };

  const setPrintSelection = (selectedKeys: string[], persist = false) => {
    const selectedKeySet = new Set(selectedKeys);
    printCheckboxes.forEach((checkbox) => {
      checkbox.checked = selectedKeySet.has(checkbox.value);
    });
    updatePrintSelectionState(persist);
  };

  const buildPrintDocument = () => {
    if (!printDocument) return;

    const selectedKeySet = new Set(getSelectedPrintKeys());
    document.documentElement.dataset.printLayout = selectedKeySet.size <= 6 ? 'compact' : 'full';
    printDocument.replaceChildren();

    getPrintOrder().forEach((printKey) => {
      if (!selectedKeySet.has(printKey)) return;

      const source = document.querySelector<HTMLElement>(`[data-print-key="${printKey}"]`);
      const option = printOptionRows.find((row) => row.dataset.printKey === printKey);
      if (!source || !option) return;

      const item = document.createElement('article');
      item.className = 'resume-print-freeform-item';

      const context = document.createElement('p');
      context.className = 'resume-print-item-context';
      context.textContent = `${option.dataset.printKind ?? ''} · ${option.dataset.printContext ?? ''}`;
      item.append(context);

      if (source.matches('.resume-additional-contributions li')) {
        const contribution = document.createElement('div');
        contribution.className = 'resume-print-contribution';
        contribution.append(source.cloneNode(true));
        item.append(contribution);
      } else {
        const content = source.cloneNode(true) as HTMLElement;
        content.removeAttribute('data-print-key');
        item.append(content);
      }

      printDocument.append(item);
    });
  };

  try {
    const savedBuilder = JSON.parse(localStorage.getItem(PRINT_BUILDER_STORAGE_KEY) ?? 'null');
    const legacySelection = JSON.parse(
      localStorage.getItem(LEGACY_PRINT_SELECTION_STORAGE_KEY) ?? 'null',
    );
    const availableKeys = new Set(printCheckboxes.map((checkbox) => checkbox.value));
    const savedSelection = Array.isArray(savedBuilder?.selectedKeys)
      ? savedBuilder.selectedKeys
      : legacySelection;
    const validSelection = Array.isArray(savedSelection)
      ? savedSelection.filter(
          (key): key is string => typeof key === 'string' && availableKeys.has(key),
        )
      : null;

    if (Array.isArray(savedBuilder?.order)) {
      setPrintOrder(
        savedBuilder.order.filter((key: unknown): key is string => typeof key === 'string'),
      );
    }

    if (validSelection) {
      setPrintSelection(validSelection, false);
    } else {
      updatePrintSelectionState(false);
    }
  } catch {
    updatePrintSelectionState(false);
  }

  configurePrintButton?.addEventListener('click', () => {
    printSelectionBeforeDialog = getSelectedPrintKeys();
    printOrderBeforeDialog = getPrintOrder();
    if (printDialog) printDialog.returnValue = 'cancel';
    updatePrintSelectionState(false);
    printDialog?.showModal();
  });

  printDialog?.addEventListener('click', (event) => {
    if (event.target === printDialog) printDialog.close('cancel');
  });

  printDialog?.addEventListener('close', () => {
    if (printDialog.returnValue !== 'print') {
      setPrintOrder(printOrderBeforeDialog);
      setPrintSelection(printSelectionBeforeDialog, false);
    }
  });

  printCheckboxes.forEach((checkbox) => {
    checkbox.addEventListener('change', () => updatePrintSelectionState(false));
  });

  printPresetButtons.forEach((button) => {
    button.addEventListener('click', () => {
      const preset = button.dataset.printPreset;
      if (preset === 'all') {
        setPrintSelection(printCheckboxes.map((checkbox) => checkbox.value));
        return;
      }
      if (preset === 'none') {
        setPrintSelection([]);
        return;
      }

      try {
        const coreKeys = JSON.parse(printDialog?.dataset.coreKeys ?? '[]');
        setPrintSelection(Array.isArray(coreKeys) ? coreKeys : []);
      } catch {
        setPrintSelection([]);
      }
    });
  });

  const getPrintOption = (target: EventTarget | null) =>
    target instanceof Element ? target.closest<HTMLLIElement>('.resume-print-option') : null;

  printOptionList?.addEventListener('dragstart', (event) => {
    const option = getPrintOption(event.target);
    if (!option || option.dataset.printSelected !== 'true') {
      event.preventDefault();
      return;
    }

    draggedPrintOption = option;
    option.classList.add('is-dragging');
    event.dataTransfer?.setData('text/plain', option.dataset.printKey ?? '');
    if (event.dataTransfer) event.dataTransfer.effectAllowed = 'move';
  });

  printOptionList?.addEventListener('dragover', (event) => {
    if (!draggedPrintOption || !printOptionList) return;
    event.preventDefault();

    const target = getPrintOption(event.target);
    if (!target || target === draggedPrintOption) {
      if (!target) printOptionList.append(draggedPrintOption);
      return;
    }

    const targetBounds = target.getBoundingClientRect();
    if (event.clientY < targetBounds.top + targetBounds.height / 2) target.before(draggedPrintOption);
    else target.after(draggedPrintOption);
  });

  printOptionList?.addEventListener('dragend', () => {
    if (!draggedPrintOption) return;
    draggedPrintOption.classList.remove('is-dragging');
    draggedPrintOption = null;
    updatePrintSelectionState(false);
  });

  printOptionList?.addEventListener('click', (event) => {
    const button = event.target instanceof Element
      ? event.target.closest<HTMLButtonElement>('[data-print-move]')
      : null;
    const option = getPrintOption(event.target);
    if (!button || !option || option.dataset.printSelected !== 'true') return;

    const move = button.dataset.printMove;
    if (move === 'up' && option.previousElementSibling) option.previousElementSibling.before(option);
    if (move === 'down' && option.nextElementSibling) option.nextElementSibling.after(option);
    updatePrintSelectionState(false);
  });

  printConfirmButton?.addEventListener('click', () => {
    if (getSelectedPrintKeys().length === 0) return;
    updatePrintSelectionState();
    buildPrintDocument();
    printDialog?.close('print');
    window.setTimeout(() => window.print(), 50);
  });

  window.addEventListener('beforeprint', buildPrintDocument);

  const resumeSections = Array.from(
    document.querySelectorAll<HTMLElement>('[data-resume-section]'),
  );
  const resumeLinks = Array.from(
    document.querySelectorAll<HTMLAnchorElement>('.resume-sidebar a'),
  );

  const updateResumeNavigation = () => {
    const firstSection = resumeSections.at(0);
    const lastSection = resumeSections.at(-1);
    if (!firstSection || !lastSection) return;

    const threshold = window.innerWidth <= 760 ? 180 : 220;
    let currentSection = firstSection;

    if (window.scrollY + window.innerHeight >= document.documentElement.scrollHeight - 2) {
      currentSection = lastSection;
    }

    if (currentSection !== lastSection) {
      for (const section of resumeSections) {
        if (section.getBoundingClientRect().top <= threshold) currentSection = section;
        else break;
      }
    }

    resumeLinks.forEach((link) => {
      const isCurrent = link.hash === `#${currentSection?.id}`;
      link.classList.toggle('active', isCurrent);
      if (isCurrent) link.setAttribute('aria-current', 'location');
      else link.removeAttribute('aria-current');
    });
  };

  updateResumeNavigation();
  document.addEventListener('scroll', updateResumeNavigation, { passive: true });
  window.addEventListener('resize', updateResumeNavigation);
</script>
