---
import PostList from '@/components/PostList.astro';
import { TECHNICAL_CATEGORIES } from '@/config';
import { getTechnicalPosts } from '@/lib/posts';
import BaseLayout from '@/layouts/BaseLayout.astro';

const posts = await getTechnicalPosts();
---

<BaseLayout title="기술 블로그" description="백엔드 개발 과정에서 다룬 기술과 문제 해결 기록을 모았습니다.">
  <header class="page-header page-container">
    <p class="section-kicker">Technical Blog</p>
    <h1>기술 블로그</h1>
    <p>구현 과정과 문제 해결, 공부한 기술을 기록합니다.</p>
  </header>

  <div class="page-container">
    <nav class="category-tabs" aria-label="기술 주제">
      <a class="active" href="/posts/" aria-current="page">전체 <span>{posts.length}</span></a>
      {TECHNICAL_CATEGORIES.map((category) => {
        const count = posts.filter((post) => post.data.category === category.name).length;
        return <a href={`/categories/${category.slug}/`}>{category.name} <span>{count}</span></a>;
      })}
    </nav>
    <PostList posts={posts} emptyMessage="첫 기술 글을 준비하고 있습니다." />
  </div>
</BaseLayout>
