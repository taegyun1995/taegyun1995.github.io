---
import type { GetStaticPaths } from 'astro';

import PostList from '@/components/PostList.astro';
import { CATEGORIES, type CategoryName } from '@/config';
import { getPublishedPosts } from '@/lib/posts';
import BaseLayout from '@/layouts/BaseLayout.astro';

export const getStaticPaths = (() =>
  CATEGORIES.map((category) => ({
    params: { slug: category.slug },
    props: { category },
  }))) satisfies GetStaticPaths;

const { category } = Astro.props as {
  category: { name: CategoryName; slug: string; description: string };
};
const posts = (await getPublishedPosts()).filter((post) => post.data.category === category.name);
---

<BaseLayout title={category.name} description={category.description}>
  <header class="page-header page-container">
    <p class="section-kicker">Category</p>
    <h1>{category.name}</h1>
    <p>{category.description}</p>
  </header>

  <div class="page-container">
    <PostList posts={posts} emptyMessage="이 카테고리의 첫 글을 준비하고 있습니다." />
  </div>
</BaseLayout>
