---
import { ArrowRight } from '@lucide/astro';

import PostList from '@/components/PostList.astro';
import { SITE } from '@/config';
import { RESUME } from '@/data/resume';
import { getTechnicalPosts } from '@/lib/posts';
import BaseLayout from '@/layouts/BaseLayout.astro';

const posts = await getTechnicalPosts();
const latestPosts = posts.slice(0, 3);
---

<BaseLayout bodyClass="home-page">
  <section class="resume-hero page-container">
    <aside class="resume-hero-career" aria-labelledby="experience-title">
      <div class="resume-hero-career-heading">
        <p class="section-kicker">Experience</p>
        <h2 id="experience-title">경력</h2>
      </div>

      <div class="resume-hero-career-list">
        {RESUME.experiences.map((experience) => (
          <article>
            <time>{experience.period}</time>
            <h3>{experience.company}</h3>
            <p>{experience.organization} · {experience.role}</p>
          </article>
        ))}
      </div>

      <a class="resume-hero-career-link" href="/resume/">상세 이력서<ArrowRight size={15} /></a>
    </aside>

    <div class="resume-hero-copy">
      <p class="intro-role">{SITE.role} · {RESUME.experienceLabel}</p>
      <h1>{RESUME.name}</h1>
      <p class="resume-hero-description">{RESUME.summary}</p>
      <div class="intro-actions">
        <a class="primary-link" href="/resume/">이력서<ArrowRight size={17} /></a>
        <a class="secondary-link" href="/portfolio/">포트폴리오<ArrowRight size={17} /></a>
        <a class="secondary-link" href="/posts/">기술 블로그<ArrowRight size={17} /></a>
        <a class="secondary-link" href="/retrospectives/">회고<ArrowRight size={17} /></a>
      </div>
    </div>

    <aside class="resume-hero-profile" aria-label="경력 요약">
      <img
        src="/images/profile.png"
        alt="이태균 GitHub 프로필"
        width="112"
        height="112"
        loading="eager"
      />
      <dl>
        <div><dt>경력</dt><dd>2023.11 - 현재</dd></div>
        <div><dt>주요 기술</dt><dd>Java · Spring</dd></div>
        <div><dt>관심 영역</dt><dd>정합성 · 성능 · 운영</dd></div>
      </dl>
    </aside>
  </section>

  <section class="home-strength-summary page-container" aria-labelledby="strength-title">
    <div class="home-overview-heading">
      <p class="section-kicker">Focus</p>
      <h2 id="strength-title">핵심 역량</h2>
    </div>

    <div class="home-strength-list">
      {RESUME.strengths.map((strength, index) => (
        <article>
          <span>{String(index + 1).padStart(2, '0')}</span>
          <div>
            <h3>{strength.title}</h3>
            <p>{strength.description}</p>
          </div>
          <small>{strength.detail}</small>
        </article>
      ))}
    </div>
  </section>

  <section class="content-section page-container" aria-labelledby="latest-posts-title">
    <div class="section-heading">
      <div>
        <p class="section-kicker">Technical Blog</p>
        <h2 id="latest-posts-title">최근 기술 글</h2>
      </div>
      <a href="/posts/">기술 블로그 보기<ArrowRight size={16} /></a>
    </div>
    <PostList
      posts={latestPosts}
      emptyMessage="기술 블로그에 구현 과정과 문제 해결 기록을 올릴 예정입니다."
    />
  </section>
</BaseLayout>
